{
  "name": "ytdlp-my",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "fix:electron": "rm -rf node_modules/electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ bun install --force",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:windows": "npm run build && electron-builder --win nsis --publish never",
    "publish": "electron-builder",
    "publish:mac": "electron-builder --mac dmg zip",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "electron": "41.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "com.alamonall.ytdlp-my",
    "productName": "yt-dlp My",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
